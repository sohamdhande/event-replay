{
  "name": "@mavericks78/event-replay",
  "version": "0.1.0",
  "description": "A dependency-free JavaScript event history engine with deterministic replay, seeking, undo, and redo.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "sideEffects": false,
  "files": [
    "src/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check src/index.js && node --check test/index.test.js && node --check examples/counter.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "event-history",
    "event-replay",
    "state-management",
    "undo",
    "redo",
    "time-travel-debugging",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohamdhande/event-replay.git"
  },
  "bugs": {
    "url": "https://github.com/sohamdhande/event-replay/issues"
  },
  "homepage": "https://github.com/sohamdhande/event-replay#readme",
  "license": "MIT"
}
